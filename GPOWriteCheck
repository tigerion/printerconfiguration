function Get-GpoWriteAcl {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$Domain,            # corp.local
        [Parameter(Mandatory)][string]$DomainController,  # dc01.corp.local  (FQDN preferred over IP)
        [Parameter(Mandatory)][string]$Username,          # CORP\jdoe  or  jdoe@corp.local
        [Parameter(Mandatory)][string]$Password,
        [string]$GpoName,                                 # displayName, e.g. "Default Domain Policy"
        [string]$GpoGuid                                  # {GUID} or bare GUID (either works)
    )

    $baseDN   = ($Domain.Split('.') | ForEach-Object { "DC=$_" }) -join ','
    $rootPath = "LDAP://$DomainController/$baseDN"
    $root     = New-Object System.DirectoryServices.DirectoryEntry($rootPath, $Username, $Password)

    # --- locate the GPO object ---
    if ($GpoGuid) {
        if ($GpoGuid -notmatch '^\{.*\}$') { $GpoGuid = "{$GpoGuid}" }
        $path = "LDAP://$DomainController/CN=$GpoGuid,CN=Policies,CN=System,$baseDN"
        $gpo  = New-Object System.DirectoryServices.DirectoryEntry($path, $Username, $Password)
    }
    elseif ($GpoName) {
        $ds = New-Object System.DirectoryServices.DirectorySearcher($root)
        $ds.Filter = "(&(objectClass=groupPolicyContainer)(displayName=$GpoName))"
        $ds.SecurityMasks = [System.DirectoryServices.SecurityMasks]::Dacl
        $hit = $ds.FindOne()
        if (-not $hit) { throw "GPO '$GpoName' not found" }
        $gpo = $hit.GetDirectoryEntry()
    }
    else { throw "Provide -GpoName or -GpoGuid" }

    # request only the DACL (avoids needing SeSecurityPrivilege for the SACL)
    $gpo.Options.SecurityMasks = [System.DirectoryServices.SecurityMasks]::Dacl
    $gpo.RefreshCache()
    Write-Host "GPO DN: $($gpo.Properties['distinguishedName'].Value)" -ForegroundColor Cyan

    # get ACEs keyed by SID (no off-domain name resolution)
    $rules = $gpo.ObjectSecurity.GetAccessRules($true, $true, [System.Security.Principal.SecurityIdentifier])

    $wellKnown = @{
        'S-1-1-0'='Everyone'; 'S-1-5-11'='Authenticated Users'; 'S-1-5-32-544'='BUILTIN\Administrators'
        'S-1-5-9'='Enterprise Domain Controllers'; 'S-1-3-0'='Creator Owner'
    }

    $rules | Where-Object {
        $_.AccessControlType -eq 'Allow' -and
        $_.ActiveDirectoryRights.ToString() -match 'GenericWrite|GenericAll|WriteProperty|WriteDacl|WriteOwner|Self'
    } | ForEach-Object {
        $sid  = $_.IdentityReference.Value
        $name = $wellKnown[$sid]
        if (-not $name) {   # best-effort resolve SID -> name via the same authenticated bind
            $f = New-Object System.DirectoryServices.DirectorySearcher($root, "(objectSid=$sid)", @('samAccountName','name'))
            $r = $f.FindOne()
            if ($r) { $name = $r.Properties['samaccountname'][0]; if (-not $name) { $name = $r.Properties['name'][0] } }
        }
        [pscustomobject]@{
            Trustee = if ($name) { $name } else { $sid }
            SID     = $sid
            Rights  = $_.ActiveDirectoryRights
        }
    } | Sort-Object Trustee | Format-Table -Auto
}
