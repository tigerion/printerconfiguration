| rex field=pluginText "Credentialed checks\s*:\s*(?<cred>\w+)"
| eval cred_status=if(match(cred,"(?i)yes"),"credentialed","NOT credentialed")
| stats latest(cred_status) as cred_status latest(lastSeen) as last_scan by dnsName ip repository
| where cred_status="NOT credentialed"
| eval last_scan=strftime(last_scan,"%Y-%m-%d %H:%M")
| sort dnsName
